# ============================================================
# TheHiggs — AI-UI Co-Execution Runtime 环境变量
# ============================================================
# 复制此文件为 .env.local 并填入实际值

# --- AI 模型配置 ---
# 模型来源（服务商）：agnes（默认）| deepseek | orcarouter
# 不设置时默认使用 Agnes AI。

# 默认服务商：Agnes AI（OpenAI Responses 兼容接口 /v1/responses）
# 文档: https://www.agnes-ai.com/zh-Hans/docs/agnes-25-flash
# 上下文窗口 512K，最大输出 65.5K；thinking 由代码固定注入
#   {"type":"enabled","budget_tokens":65536}，无需额外配置
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://apihub.agnes-ai.com/v1
AI_MODEL=agnes-2.5-flash

# --- 可选服务商：DeepSeek（OpenAI 兼容 /v1/chat/completions）---
# 启用方式：设置 AI_PROVIDER=deepseek，并按需覆盖上面三个变量
# AI_PROVIDER=deepseek
# OPENAI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-v4-flash-vision-exp
# DEEPSEEK_THINKING=disabled
#   # enabled | disabled | auto；仅 DeepSeek 来源生效（不设置 = 不注入）

# --- 可选服务商：OrcaRouter（OpenAI 兼容网关，200+ 模型 / 自动路由 / 零加价）---
# 启用方式（二选一）：
#   1) 设置 AI_PROVIDER=orcarouter
#   2) 设置 ORCAROUTER_API_KEY（会自动切换并默认模型 orcarouter/auto）
# 注册并创建 Key: https://www.orcarouter.ai/ref/ref_c2667d797b82b3181496
# ORCAROUTER_API_KEY=sk-orca-your-key-here
# ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
# AI_MODEL=orcarouter/auto   # 或 deepseek/deepseek-v4-flash-vision-exp、qwen/qwen3.8-flash 等

# --- Mock 模式 ---
# 设为 true 时使用内置 Mock AI Runtime，无需 API Key 即可运行完整演示
USE_MOCK_AI=false

# --- 搜索 API 配置（可选，无 Key 时自动使用 Bing 免费搜索）---
# Serper.dev API Key（Google 搜索质量，2500 免费额度/月）
# 获取: https://serper.dev
# SERPER_API_KEY=your-serper-key-here

# Pixabay API Key（免费图片搜索，5000 请求/小时）
# 获取: https://pixabay.com/api/docs/
# PIXABAY_API_KEY=your-pixabay-key-here

# Pexels API Key（免费图片搜索，200 请求/小时）
# 获取: https://www.pexels.com/api/
# PEXELS_API_KEY=your-pexels-key-here