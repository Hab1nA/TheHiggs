# ============================================================
# TheHiggs — AI-UI Co-Execution Runtime 环境变量
# ============================================================
# 复制此文件为 .env.local 并填入实际值

# --- AI 模型配置 ---
# OpenAI API Key（若使用 OpenAI 兼容 provider）
OPENAI_API_KEY=sk-your-key-here

# 模型选择（gpt-4.1 / gpt-4o / gpt-4o-mini 等）
AI_MODEL=gpt-4.1

# --- Mock 模式 ---
# 设为 true 时使用内置 Mock AI Runtime，无需 API Key 即可运行完整演示
USE_MOCK_AI=false

# --- 可选：其他 AI Provider ---
# 若使用 Anthropic / Google / xAI 等，通过 AI SDK provider 配置
# 参考：https://sdk.vercel.ai/providers
