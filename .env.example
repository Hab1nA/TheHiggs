# ============================================================
# TheHiggs — AI-UI Co-Execution Runtime 环境变量
# ============================================================
# 复制此文件为 .env.local 并填入实际值

# --- AI 模型配置 ---
# OpenAI 兼容 API Key
OPENAI_API_KEY=sk-your-key-here

# OpenAI 兼容 API Base URL
OPENAI_BASE_URL=https://opencode.ai/zen/go/v1

# 模型选择（deepseek-v4-flash / deepseek-reasoner 等）
AI_MODEL=deepseek-v4-flash

# --- 思考模式（DeepSeek V4 系列专属）---
# enabled  = 启用思维链推理（回答更深入，但更慢，可能影响 JSON 输出稳定性）
# disabled = 禁用思维链（回答更快，JSON 输出更可靠）
# auto     = 由模型自行决定
# 不设置   = 不注入参数，由模型默认行为决定
DEEPSEEK_THINKING=disabled

# --- Mock 模式 ---
# 设为 true 时使用内置 Mock AI Runtime，无需 API Key 即可运行完整演示
USE_MOCK_AI=false

# --- 搜索 API 配置（可选，无 Key 时自动使用 Bing 免费搜索）---
# Serper.dev API Key（Google 搜索质量，2500 免费额度/月）
# 获取: https://serper.dev
# SERPER_API_KEY=your-serper-key-here

# Pixabay API Key（免费图片搜索，5000 请求/小时）
# 获取: https://pixabay.com/api/docs/
# PIXABAY_API_KEY=your-pixabay-key-here

# Pexels API Key（免费图片搜索，200 请求/小时）
# 获取: https://www.pexels.com/api/
# PEXELS_API_KEY=your-pexels-key-here
