{
  "name": "thehiggs",
  "version": "0.3.0",
  "private": true,
  "main": "dist-electron/main.js",
  "description": "AI-UI Co-Execution Runtime — LLM 驻留在自己生成的 UI 中，形成 AI-UI 共执行循环",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "electron:dev": "tsc -p tsconfig.electron.json && electron .",
    "electron:build": "npm run build && tsc -p tsconfig.electron.json && electron-builder --config electron-builder.yml"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.3.0",
    "@copilotkit/react-core": "^1.40.0",
    "@copilotkit/react-ui": "^1.40.0",
    "ai": "^4.3.0",
    "next": "^15.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "undici": "^8.4.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.2",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.3.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0"
  }
}
