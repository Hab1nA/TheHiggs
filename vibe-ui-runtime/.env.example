# OpenAI API Key (optional - leave empty for mock mode)
OPENAI_API_KEY=

# Model to use (optional - defaults to gpt-4.1)
OPENAI_MODEL=gpt-4.1

# API Base URL (optional - for compatible APIs like Azure, OpenRouter, etc.)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Runtime mode: "mock" | "llm"
# When OPENAI_API_KEY is empty, always falls back to mock mode
NEXT_PUBLIC_RUNTIME_MODE=mock
